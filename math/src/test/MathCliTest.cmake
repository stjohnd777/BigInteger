if(PROGRAM STREQUAL "fib")
    set(usage "Usage: main_fib INDEX\n")
    set(result_arg 100)
    set(result_stdout "354224848179261915075\n")
    set(zero_stdout "0\n")
elseif(PROGRAM STREQUAL "prime")
    set(usage "Usage: main_prime LIMIT\n")
    set(result_arg 10)
    set(result_stdout "2\n3\n5\n7\n")
    set(zero_stdout "")
else()
    message(FATAL_ERROR "Unknown CLI program: ${PROGRAM}")
endif()

set(expected_stdout "")
set(expected_stderr "")
set(expected_status 0)
set(expect_timing FALSE)

if(CASE STREQUAL "result")
    set(args ${result_arg})
    set(expected_stdout "${result_stdout}")
    set(expect_timing TRUE)
elseif(CASE STREQUAL "zero")
    set(args 0)
    set(expected_stdout "${zero_stdout}")
    set(expect_timing TRUE)
elseif(CASE STREQUAL "help")
    set(args --help)
    set(expected_stdout "${usage}")
elseif(CASE STREQUAL "missing")
    set(args)
    set(expected_status 2)
    set(expected_stderr "${usage}")
elseif(CASE STREQUAL "extra")
    set(args 10 20)
    set(expected_status 2)
    set(expected_stderr "${usage}")
elseif(CASE STREQUAL "negative")
    set(args -1)
elseif(CASE STREQUAL "invalid")
    set(args 10x)
elseif(CASE STREQUAL "overflow")
    set(args 999999999999999999999999999999999999)
else()
    message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()

if(CASE STREQUAL "negative" OR CASE STREQUAL "invalid" OR CASE STREQUAL "overflow")
    set(expected_status 1)
    set(expected_stderr "main_${PROGRAM}: expected a non-negative integer within the range of long\n")
endif()

execute_process(COMMAND "${EXECUTABLE}" ${args}
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(expect_timing AND "${stderr}" MATCHES "^Computation time: [0-9]+\\.[0-9][0-9][0-9][0-9][0-9][0-9] seconds\n$")
    set(expected_stderr "${stderr}")
endif()
if(NOT "${status}" STREQUAL "${expected_status}" OR
   NOT "${stdout}" STREQUAL "${expected_stdout}" OR
   NOT "${stderr}" STREQUAL "${expected_stderr}")
    message(FATAL_ERROR "Unexpected CLI result for ${PROGRAM} ${CASE}:\nstatus: ${status}\nstdout: [${stdout}]\nstderr: [${stderr}]")
endif()
